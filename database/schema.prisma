// Prisma Schema for ocaventeDz - Independent Algerian Classifieds & Marketplace Platform

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum ListingStatus {
  PENDING
  ACTIVE
  REJECTED
  SOLD
}

enum PaymentMethod {
  CCP
  BARIDIMOB
  CASH
  VOUCHER
}

enum RechargeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  RECHARGE
  FEATURED_AD_FEE
  LISTING_FEE
  REFUND
  ADMIN_ADJUSTMENT
}

enum NotificationType {
  LISTING_STATUS
  RECHARGE_STATUS
  SYSTEM
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  username            String               @unique
  passwordHash        String
  phone               String?
  wilaya              String               @default("16 - الجزائر (Alger)")
  role                Role                 @default(USER)
  balance             Decimal              @default(0.0) @db.Decimal(12, 2)
  avatarUrl           String?
  isBlocked           Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  listings            Listing[]
  favorites           Favorite[]
  rechargeRequests    RechargeRequest[]
  balanceTransactions BalanceTransaction[]
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  adminLogs           AuditLog[]           @relation("AdminAuditLogs")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Category {
  id        String    @id @default(uuid())
  nameAr    String
  nameFr    String
  slug      String    @unique
  icon      String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  listings  Listing[]
}

model Listing {
  id              String         @id @default(uuid())
  title           String
  description     String
  price           Decimal        @db.Decimal(12, 2)
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wilaya          String
  commune         String?
  phone           String
  isNegotiable    Boolean        @default(true)
  status          ListingStatus  @default(PENDING)
  rejectionReason String?
  views           Int            @default(0)
  isFeatured      Boolean        @default(false)
  featuredUntil   DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  images          ListingImage[]
  favorites       Favorite[]
}

model ListingImage {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model RechargeRequest {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Decimal        @db.Decimal(12, 2)
  paymentMethod   PaymentMethod  @default(BARIDIMOB)
  receiptNumber   String
  receiptImageUrl String?
  status          RechargeStatus @default(PENDING)
  adminNotes      String?
  reviewedBy      String?
  createdAt       DateTime       @default(now())
  reviewedAt      DateTime?
}

model BalanceTransaction {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Decimal         @db.Decimal(12, 2)
  type         TransactionType
  description  String
  referenceId  String?
  balanceAfter Decimal         @db.Decimal(12, 2)
  createdAt    DateTime        @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation("AdminAuditLogs", fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}
